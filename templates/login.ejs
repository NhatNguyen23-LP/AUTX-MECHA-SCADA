<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Authentication System | SCADA CORE</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css">

    <style>
        :root {
            --primary-tech: #1a56db;
            --bg-body: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #1e293b;
            --border-ui: #e2e8f0;
        }

        body {
            background-color: var(--bg-body);
            color: var(--text-main);
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', -apple-system, sans-serif;
            margin: 0;
            letter-spacing: -0.01em;
        }

        .auth-card {
            background: var(--card-bg);
            border: 1px solid var(--border-ui);
            border-radius: 12px;
            padding: 2.5rem;
            width: 100%;
            max-width: 400px;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05);
            animation: subtleFade 0.8s cubic-bezier(0.4, 0, 0.2, 1);
        }

        @keyframes subtleFade {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .brand-header { text-align: center; margin-bottom: 2rem; }
        .brand-icon {
            width: 56px; height: 56px; background: #eff6ff; color: var(--primary-tech);
            border-radius: 10px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1rem; border: 1px solid #dbeafe;
        }

        .system-title { font-weight: 800; font-size: 1.25rem; letter-spacing: 0.5px; }
        .system-subtitle { font-size: 0.75rem; text-transform: uppercase; color: #64748b; font-weight: 600; }

        .form-label { font-size: 0.8rem; font-weight: 600; color: #475569; margin-bottom: 0.5rem; }
        .form-control { border: 1px solid var(--border-ui); padding: 10px 12px; font-size: 0.9rem; transition: all 0.2s; }
        .form-control:focus { border-color: var(--primary-tech); box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.1); }

        .btn-primary {
            background: var(--primary-tech); border: none; padding: 12px; font-weight: 700;
            border-radius: 6px; text-transform: uppercase; letter-spacing: 0.5px; margin-top: 1rem;
        }

        /* THÔNG BÁO */
        .alert { border-radius: 8px; font-size: 0.8rem; border: none; padding: 12px; margin-bottom: 1.5rem; font-weight: 500; }
        .alert-success { background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; }
        .alert-danger { background: #fef2f2; color: #991b1b; border: 1px solid #fecaca; }

        .footer-links { text-align: center; margin-top: 2rem; font-size: 0.8rem; color: #64748b; }
        .register-link { color: var(--primary-tech); text-decoration: none; font-weight: 700; }
        .id-badge { font-family: monospace; background: #f1f5f9; padding: 2px 6px; border-radius: 4px; font-size: 0.7rem; }
    </style>
</head>
<body>

    <div class="auth-card">
        <div class="brand-header">
            <div class="brand-icon"><i class="fas fa-terminal fa-lg"></i></div>
            <div class="system-title">SCADA CORE</div>
            <div class="system-subtitle">Authentication Portal</div>
        </div>

        <!-- 1. CHATBOX CHÀO MỪNG (HIỆN KHI ĐĂNG KÝ THÀNH CÔNG) -->
        <% if (locals.welcome && welcome.length > 0) { %>
            <% welcome.forEach(function(msg) { %>
                <div class="alert alert-success d-flex align-items-center animate__animated animate__backInDown">
                    <i class="fas fa-circle-check me-2"></i>
                    <div><%= msg %></div>
                </div>
            <% }); %>
        <% } %>

        <!-- 2. THÔNG BÁO LỖI (SAI TÀI KHOẢN/MẬT KHẨU) -->
        <% if (locals.messages && messages.length > 0) { %>
            <% messages.forEach(function(msg) { %>
                <div class="alert alert-danger d-flex align-items-center animate__animated animate__shakeX">
                    <i class="fas fa-triangle-exclamation me-2"></i>
                    <div><%= msg %></div>
                </div>
            <% }); %>
        <% } %>

        <form action="/login" method="POST">
            <div class="mb-3">
                <label class="form-label text-uppercase">Operator Username</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-user-tag" style="font-size: 0.8rem;"></i></span>
                    <input type="text" name="username" class="form-control" placeholder="Nhập tên đăng nhập..." required>
                </div>
            </div>
            
            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="form-label text-uppercase mb-0">Security Password</label>
                </div>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-shield-keyhole" style="font-size: 0.8rem;"></i></span>
                    <input type="password" name="password" class="form-control" placeholder="••••••••" required>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 shadow-sm">
                <i class="fas fa-unlock-keyhole me-2"></i> Xác thực truy cập
            </button>
            
            <div class="footer-links">
                <p class="mb-2">Nhân viên chưa có tài khoản? <a href="/register" class="register-link">Đăng ký hồ sơ</a></p>
                <span class="id-badge">LH_AUTX CORE V2.1.0</span>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>