                <h6 class="modal-title fw-bold"><i class="fas fa-plus-circle me-2"></i>THIẾT LẬP THIẾT BỊ MỚI</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
