</div>

<div class="modal fade" id="addWeekModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white"><h6 class="modal-title fw-bold">CHỌN TUẦN MỚI</h6><button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button></div>
            <div class="modal-body p-3">
                <div class="mb-2"><label class="small fw-bold">TỪ NGÀY</label><input type="date" id="week-start-date" class="form-control border-primary"></div>
                <div class="mb-3"><label class="small fw-bold">ĐẾN NGÀY</label><input type="date" id="week-end-date" class="form-control border-primary"></div>
                <div class="p-2 bg-light rounded text-center mb-3">
                    <span class="small text-muted">Preview:</span><br><code id="preview-week-text" class="fw-bold text-primary">chưa chọn...</code>
                </div>
                <button class="btn btn-primary btn-sm w-100 fw-bold" onclick="submitNewWeek()">XÁC NHẬN KHỞI TẠO</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL THÊM THIẾT BỊ MỚI -->
