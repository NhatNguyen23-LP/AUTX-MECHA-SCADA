                <div class="mb-3">
                    <label class="small fw-bold text-muted">TÊN THIẾT BỊ / TRẠM SCADA</label>
                    <input type="text" id="new-machine-name" class="form-control border-primary" placeholder="VD: CNC Milling V3">
