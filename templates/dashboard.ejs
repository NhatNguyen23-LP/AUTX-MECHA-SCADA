                        </tr>
                    </thead>
                    <tbody id="user-table-body">
                        </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="tech-card h-100">
            <h6 class="fw-bold mb-3 small text-uppercase"><i class="fas fa-key me-2"></i>MÃ MỜI ĐĂNG KÝ</h6>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead class="table-light">
                        <tr class="small text-muted">
                            <th>MÃ CODE</th>
                            <th>QUYỀN HẠN</th>
                        </tr>
                    </thead>
                    <tbody id="invite-table-body">
                        </tbody>
                </table>
            </div>
            <div class="mt-3">
                <button class="btn btn-primary btn-sm w-100 fw-bold" onclick="generateInviteCode()"><i class="fas fa-plus-circle me-2"></i>TẠO MÃ MỚI</button>
